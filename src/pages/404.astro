---
import Base from '../layouts/Base.astro';
import ClawSlash from '../components/fx/ClawSlash.astro';
import BloodDrip from '../components/fx/BloodDrip.astro';
import ChainHook from '../components/fx/ChainHook.astro';
---
<Base title="Pagina no encontrada" description="La pagina solicitada no existe en DBD Academy." active="inicio">
  <section class="not-found">
    <ChainHook small />
    <BloodDrip />
    <div class="container" data-reveal>
      <p class="eyebrow">Error 404</p>
      <h1 class="display">Esta ruta quedo<br/><span>sin luz<ClawSlash /></span></h1>
      <p>La pagina que buscas no existe o ya cambio de ubicacion.</p>
      <a class="btn btn-primary" href="/">Volver al inicio</a>
    </div>
  </section>
</Base>

<style>
 .not-found { position:relative; isolation:isolate; min-height:680px; display:flex; align-items:center; margin-top:72px; overflow:clip; background:radial-gradient(circle at 70% 50%,rgba(193,18,31,.16),transparent 32%),var(--bg); }
 .not-found :global(.container) { position:relative; z-index:1; }
 .not-found > :global(.chain-hook) { position:absolute; top:0; right:14%; width:52px; }
 .not-found h1 { margin:12px 0 20px; font-size:clamp(4rem,12vw,8rem); }
 .not-found h1 span { position:relative; isolation:isolate; }
 .not-found h1 :global(.claw-slash) { z-index:-1; inset:-10% -12%; opacity:.7; }
 .not-found p:not(.eyebrow) { margin:0 0 28px; color:var(--muted); }
</style>
