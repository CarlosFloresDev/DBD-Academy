---
import Base from '../../layouts/Base.astro';
import SectionHead from '../../components/SectionHead.astro';
import Chip from '../../components/Chip.astro';
import ClockOverlay from '../../components/callouts/ClockOverlay.astro';
import callouts from '../../data/callouts.json';

const modPositions = [
  { x: 50, y: 50 },
  { x: 50, y: 34 },
  { x: 50, y: 66 },
  { x: 65, y: 50 },
  { x: 7, y: 50 },
  { x: 78, y: 50 },
];
// Base's current active-key type predates the Callouts link already present in Nav.
const calloutsActive = 'callouts' as never;
---

<Base
  title="Callouts"
  description="Aprende el reloj de callouts de Dead by Daylight: orientacion, modificadores y entrenamiento interactivo."
  active={calloutsActive}
>
  <section class="hero container" data-reveal>
    <div class="hero-copy">
      <p class="eyebrow">Sala de análisis / Comunicación</p>
      <h1 class="display">HABLA EL<br /><span>IDIOMA DEL MAPA</span></h1>
      <p class="hero-lede">Un reloj convierte cualquier mapa en referencias claras. El equipo comparte la misma orientación aunque cambien los tiles.</p>
      <p class="hero-callout"><span class="callout-light" aria-hidden="true"></span><span class="mono">Killer en 4</span><small>La manecilla se detiene en el sector.</small></p>
    </div>
    <div class="hero-diagram" id="hero-clock" data-reveal>
      <span class="diagram-tag mono">12 / sentido horario</span>
      <ClockOverlay />
    </div>
  </section>

  <section class="rule container section-space" id="regla" data-reveal>
    <SectionHead
      eyebrow="01 / La regla"
      title={callouts.regla.titulo}
      description="Antes de dar una posición, fija el mismo norte mental que el resto del equipo."
    />
    <div class="rule-layout">
      <ol class="rule-list">
        {callouts.regla.puntos.map((point, index) => (
          <li>
            <span class="rule-index mono">{String(index + 1).padStart(2, '0')}</span>
            <p>{point}</p>
          </li>
        ))}
      </ol>
      <aside class="rule-aside">
        <div class="rule-clock">
          <ClockOverlay showMain={true} showShack={true} />
        </div>
        <div class="convention">
          <span class="eyebrow">Convenciones</span>
          <p>{callouts.regla.puntos[5]}</p>
          <span class="mono convention-mark">ACUERDO &gt; COSTUMBRE</span>
        </div>
      </aside>
    </div>
  </section>

  <section class="modifiers container section-space" id="modificadores" data-reveal>
    <SectionHead
      eyebrow="02 / Precisión"
      title="AFINA LA POSICIÓN"
      description="El número sitúa el sector; el modificador dice qué parte del sector necesitas."
    />
    <div class="modifier-grid">
      {callouts.modificadores.map((mod, index) => {
        const target = modPositions[index];
        if (!target) throw new Error(`Falta el diagrama del modificador ${mod.t}`);
        return (
          <article class="modifier-card">
            <div class="mini-map">
              <svg viewBox="0 0 100 100" role="img" aria-label={`Diagrama de ${mod.t}`}>
                <rect x="7" y="7" width="86" height="86" />
                <circle cx="50" cy="50" r="37" />
                <path d="M50 13v74M13 50h74" />
                <circle class="mini-center" cx="50" cy="50" r="3" />
                <circle class="mini-point" cx={target.x} cy={target.y} r="4" />
              </svg>
            </div>
            <div>
              <h3 class="display">{mod.t}</h3>
              <p>{mod.d}</p>
            </div>
          </article>
        );
      })}
    </div>
  </section>

  <section class="trainer container section-space" id="entrenador" data-reveal>
    <SectionHead
      eyebrow="03 / Práctica"
      title="ENTRENA EL RELOJ"
      description="Dos ejercicios, una regla: el sector 12 queda arriba; el 3 a la derecha, el 6 abajo y el 9 a la izquierda."
    />
    <div class="trainer-shell" id="trainer">
      <div class="trainer-top">
        <div class="mode-switch" role="group" aria-label="Modo de entrenamiento">
          <button type="button" data-mode="read" aria-pressed="true">01 / Lee la llamada</button>
          <button type="button" data-mode="make" aria-pressed="false">02 / Haz la llamada</button>
        </div>
        <div class="trainer-stats" aria-label="Estadísticas de práctica">
          <span><b id="streak-value" class="mono">0</b> racha</span>
          <span><b id="accuracy-value" class="mono">0%</b> precisión</span>
          <span id="best-value"><b class="mono">0</b> mejor racha</span>
        </div>
      </div>
      <div class="training-grid">
        <div class="training-prompt">
          <p class="eyebrow" id="training-mode-label">Lee la llamada / encuentra el sector</p>
          <p class="training-callout mono" id="callout-prompt">gen en 7 edge</p>
          <p class="training-help" id="training-help">Selecciona en el reloj el sector y el anillo que escuchas. También puedes recorrerlo con Tab y activar con Enter o espacio.</p>
          <div class="answer-options" id="answer-options" hidden></div>
          <div class="training-actions">
            <button type="button" class="btn btn-primary" id="next-round" disabled>Siguiente ronda</button>
          </div>
          <p class="feedback" id="training-feedback" aria-live="polite" aria-atomic="true">Elige una posición para empezar.</p>
          <p class="storage-note" id="storage-note" hidden>El navegador no permite guardar la mejor racha en este dispositivo.</p>
        </div>
        <div class="training-clock" id="trainer-clock">
          <ClockOverlay interactive={true} />
        </div>
      </div>
    </div>
  </section>

  <section class="examples container section-space" id="ejemplos" data-reveal>
    <SectionHead
      eyebrow="04 / En partida"
      title="ESCUCHA. UBICA. RESPONDE."
      description="Frases cortas para que una llamada se convierta en una acción compartida."
    />
    <div class="message-list">
      {callouts.ejemplos.map((example, index) => (
        <article class:list={['message-row', { 'message-row-right': index % 2 === 1 }]}>
          <div class="message-meta"><Chip>COMMS / {String(index + 1).padStart(2, '0')}</Chip></div>
          <div class="message-bubble">
            <p class="message-english">{example.en}<span>Texto de ejemplo en inglés</span></p>
            <p class="message-spanish">{example.es}<span>Traducción</span></p>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="layers container section-space" id="capas" data-reveal>
    <SectionHead
      eyebrow="05 / Estructura"
      title="CAPAS DE UNA LLAMADA"
      description="Añade solo el detalle que hace falta para que tu equipo sepa dónde mirar."
    />
    <div class="layer-list">
      {callouts.capas.map((layer, index) => (
        <article class="layer-row">
          <span class="layer-number mono">0{index + 1}</span>
          <div class="layer-name"><h3 class="display">{layer.t}</h3><p>{layer.d}</p></div>
          <p class="layer-example mono">{layer.ej}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="layouts container section-space" id="layouts" data-reveal>
    <SectionHead
      eyebrow="06 / Referencias"
      title="LAYOUTS REALES"
      description="El reloj orienta; los layouts de cada mapa ayudan a reconocer estructuras y rutas."
    />
    <div class="layout-source">
      <div>
        <p>{callouts.layouts.aviso}</p>
        <div class="source-buttons">
          <a class="btn btn-primary" href={callouts.layouts.hens} target="_blank" rel="noopener noreferrer">Callouts de Hens <span aria-hidden="true">↗</span></a>
          <a class="btn btn-secondary" href={callouts.layouts.vault} target="_blank" rel="noopener noreferrer">Mapas de DBD Vault <span aria-hidden="true">↗</span></a>
        </div>
      </div>
      <aside class="sources">
        <h3 class="eyebrow">Fuentes y crédito</h3>
        <ul>
          {callouts.fuentes.map((source) => (
            <li><a href={source.u} target="_blank" rel="noopener noreferrer">{source.t}<span aria-hidden="true"> ↗</span></a></li>
          ))}
        </ul>
      </aside>
    </div>
  </section>

  <nav class="next-steps container" aria-label="Sigue aprendiendo">
    <a class="next-link" href="/mapas/">
      <span class="eyebrow">Siguiente análisis</span>
      <strong class="display">EXPLORA LOS MAPAS <span aria-hidden="true">→</span></strong>
    </a>
    <a class="next-link next-link-secondary" href="/competitivo/">
      <span class="eyebrow">Estándar comunitario, no oficial</span>
      <strong class="display">REGLAS COMPETITIVAS <span aria-hidden="true">→</span></strong>
    </a>
  </nav>
</Base>

<script>
  type Ring = 'mid' | 'deep' | 'edge';
  type Point = { n: number; ring: Ring };
  type Mode = 'read' | 'make';

  const trainer = document.querySelector<HTMLElement>('#trainer');
  if (trainer) {
    const prompt = trainer.querySelector<HTMLElement>('#callout-prompt');
    const modeLabel = trainer.querySelector<HTMLElement>('#training-mode-label');
    const help = trainer.querySelector<HTMLElement>('#training-help');
    const feedback = trainer.querySelector<HTMLElement>('#training-feedback');
    const options = trainer.querySelector<HTMLElement>('#answer-options');
    const nextButton = trainer.querySelector<HTMLButtonElement>('#next-round');
    const streakValue = trainer.querySelector<HTMLElement>('#streak-value');
    const accuracyValue = trainer.querySelector<HTMLElement>('#accuracy-value');
    const bestValue = trainer.querySelector<HTMLElement>('#best-value');
    const bestCount = bestValue?.querySelector<HTMLElement>('b');
    const storageNote = trainer.querySelector<HTMLElement>('#storage-note');
    const clock = trainer.querySelector<HTMLElement>('#trainer-clock');
    const modeButtons = trainer.querySelectorAll<HTMLButtonElement>('[data-mode]');

    if (prompt && modeLabel && help && feedback && options && nextButton && streakValue && accuracyValue && bestValue && bestCount && storageNote && clock) {
      const rings: Ring[] = ['mid', 'deep', 'edge'];
      const calloutKinds = ['killer', 'gen', 'chase', 'save'];
      let mode: Mode = 'read';
      let question: Point = { n: 7, ring: 'edge' };
      let streak = 0;
      let best = 0;
      let attempts = 0;
      let correct = 0;
      let answered = false;
      let storageAvailable = true;

      try {
        const saved = Number(localStorage.getItem('dbd-callouts-best-streak') ?? 0);
        if (Number.isFinite(saved) && saved > 0) best = saved;
      } catch {
        storageAvailable = false;
      }

      const labelPoint = (point: Point) => {
        if (point.ring === 'deep') return `deep ${point.n}`;
        return `${point.n} ${point.ring}`;
      };

      const randomPoint = (): Point => {
        const ring = rings[Math.floor(Math.random() * rings.length)];
        if (!ring) throw new Error('No se pudo elegir un anillo para la práctica.');
        return { n: Math.floor(Math.random() * 12) + 1, ring };
      };

      const randomCallout = (point: Point) => {
        const kind = calloutKinds[Math.floor(Math.random() * calloutKinds.length)];
        if (!kind) throw new Error('No hay llamadas disponibles para la práctica.');
        return `${kind} en ${labelPoint(point)}`;
      };

      const renderStats = () => {
        streakValue.textContent = String(streak);
        accuracyValue.textContent = `${attempts ? Math.round((correct / attempts) * 100) : 0}%`;
        bestCount.textContent = String(best);
        storageNote.hidden = storageAvailable;
      };

      const clearMapTarget = () => {
        clock.querySelectorAll('[data-target="true"]').forEach((item) => item.removeAttribute('data-target'));
      };

      const setRound = () => {
        question = randomPoint();
        answered = false;
        nextButton.disabled = true;
        feedback.textContent = 'Elige una posición para empezar.';
        feedback.className = 'feedback';
        clearMapTarget();

        if (mode === 'read') {
          prompt.textContent = randomCallout(question);
          options.hidden = true;
          help.textContent = 'Selecciona en el reloj el sector y el anillo que escuchas. También puedes recorrerlo con Tab y activar con Enter o espacio.';
          return;
        }

        prompt.textContent = 'La marca roja señala una posición.';
        help.textContent = 'Elige entre las tres opciones la llamada que describe el punto marcado.';
        options.hidden = false;
        clock.querySelector<SVGElement>(`[data-callout-sector="${question.n}"][data-ring="${question.ring}"]`)?.setAttribute('data-target', 'true');

        const choices = [question];
        while (choices.length < 3) {
          const candidate = randomPoint();
          if (!choices.some((choice) => choice.n === candidate.n && choice.ring === candidate.ring)) choices.push(candidate);
        }
        choices.sort(() => Math.random() - 0.5);
        options.replaceChildren(...choices.map((choice) => {
          const button = document.createElement('button');
          button.type = 'button';
          button.className = 'answer-option mono';
          button.textContent = labelPoint(choice);
          button.addEventListener('click', () => resolveAnswer(choice.n === question.n && choice.ring === question.ring));
          return button;
        }));
      };

      const resolveAnswer = (isCorrect: boolean) => {
        if (answered) return;
        answered = true;
        attempts += 1;
        if (isCorrect) {
          correct += 1;
          streak += 1;
          if (streak > best) {
            best = streak;
            if (storageAvailable) {
              try {
                localStorage.setItem('dbd-callouts-best-streak', String(best));
              } catch {
                storageAvailable = false;
              }
            }
          }
          feedback.textContent = `Correcto. ${labelPoint(question)}.`;
          feedback.className = 'feedback is-correct';
        } else {
          streak = 0;
          feedback.textContent = `No. La llamada correcta era ${labelPoint(question)}.`;
          feedback.className = 'feedback is-wrong';
        }
        if (mode === 'make') {
          options.querySelectorAll<HTMLButtonElement>('button').forEach((button) => { button.disabled = true; });
        }
        nextButton.disabled = false;
        renderStats();
      };

      modeButtons.forEach((button) => {
        button.addEventListener('click', () => {
          mode = button.dataset.mode === 'make' ? 'make' : 'read';
          modeButtons.forEach((item) => item.setAttribute('aria-pressed', String(item === button)));
          modeLabel.textContent = mode === 'read' ? 'Lee la llamada / encuentra el sector' : 'Haz la llamada / identifica el punto';
          setRound();
        });
      });

      nextButton.addEventListener('click', setRound);
      trainer.addEventListener('callout:select', (event) => {
        if (mode !== 'read') return;
        const selection = (event as CustomEvent<{ n: number; ring: string; source: string }>).detail;
        if (selection.source !== 'click' && selection.source !== 'keyboard') return;
        resolveAnswer(selection.n === question.n && selection.ring === question.ring);
      });

      renderStats();
      setRound();
    }
  }
</script>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(300px, .9fr);
    align-items: center;
    gap: clamp(24px, 5vw, 72px);
    padding-top: 136px;
    padding-bottom: 72px;
  }

  .hero-copy { max-width: 700px; }
  .hero h1 { margin: 18px 0 22px; font-size: clamp(3.8rem, 10vw, 8.5rem); }
  .hero h1 span { color: var(--blood-2); }
  .hero-lede { max-width: 580px; color: var(--muted); font-size: clamp(1rem, 2vw, 1.16rem); }

  .hero-callout {
    display: flex;
    width: fit-content;
    align-items: center;
    gap: 12px;
    margin: 32px 0 0;
    border-left: 2px solid var(--blood);
    padding: 8px 0 8px 14px;
  }

  .hero-callout .mono { color: var(--amber); font-size: 1.05rem; font-weight: 700; }
  .hero-callout small { max-width: 120px; color: var(--muted); font-size: .72rem; line-height: 1.35; }
  .callout-light { width: 7px; height: 7px; border-radius: 50%; background: var(--blood-2); box-shadow: 0 0 12px var(--blood); }
  .hero-diagram { position: relative; width: min(100%, 470px); justify-self: center; }
  .diagram-tag { position: absolute; top: 0; right: 0; z-index: 1; color: var(--muted); font-size: .65rem; letter-spacing: .12em; }
  #hero-clock :global(.clock-hand) { animation: point-at-four 4.8s cubic-bezier(.16, 1, .3, 1) 1s both; }

  .section-space { padding-top: 76px; padding-bottom: 76px; }
  .rule-layout { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(260px, .75fr); gap: clamp(24px, 6vw, 84px); align-items: start; }
  .rule-list { list-style: none; margin: 0; padding: 0; }
  .rule-list li { display: grid; grid-template-columns: 44px 1fr; gap: 12px; border-top: 1px solid var(--line); padding: 16px 0; }
  .rule-index { color: var(--blood-2); font-size: .8rem; }
  .rule-list p { margin: 0; color: var(--text); }
  .rule-aside { position: sticky; top: 96px; }
  .rule-clock { max-width: 320px; margin-inline: auto; }
  .convention { margin-top: 20px; border: 1px solid var(--line); border-left: 2px solid var(--amber); background: var(--bg-2); padding: 18px; }
  .convention p { margin: 10px 0 16px; color: var(--muted); font-size: .9rem; }
  .convention-mark { color: var(--amber); font-size: .68rem; letter-spacing: .08em; }

  .modifier-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); border-top: 1px solid var(--line); border-left: 1px solid var(--line); }
  .modifier-card { display: grid; grid-template-columns: minmax(72px, .42fr) 1fr; align-items: center; gap: 16px; min-height: 164px; border-right: 1px solid var(--line); border-bottom: 1px solid var(--line); padding: 20px; }
  .mini-map svg { width: 92px; max-width: 100%; }
  .mini-map rect { fill: var(--bg-2); stroke: var(--line); }
  .mini-map circle { fill: none; stroke: var(--muted); stroke-width: 1; }
  .mini-map path { stroke: var(--line); stroke-width: 1; stroke-dasharray: 2 3; }
  .mini-map .mini-center { fill: var(--amber); stroke: none; }
  .mini-map .mini-point { fill: var(--blood-2); stroke: var(--bg); stroke-width: 1; }
  .modifier-card h3 { margin: 0 0 8px; color: var(--text); font-size: clamp(1.35rem, 2.4vw, 2rem); }
  .modifier-card p { margin: 0; color: var(--muted); font-size: .84rem; line-height: 1.5; }

  .trainer-shell { border: 1px solid var(--line); background: var(--bg-2); }
  .trainer-top { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 16px; border-bottom: 1px solid var(--line); padding: 14px 18px; }
  .mode-switch { display: flex; flex-wrap: wrap; gap: 6px; }
  .mode-switch button { min-height: 42px; border: 1px solid transparent; border-radius: var(--r); background: transparent; padding: 8px 12px; color: var(--muted); font-family: "Barlow Condensed", sans-serif; font-size: 1rem; font-weight: 700; letter-spacing: .04em; text-transform: uppercase; cursor: pointer; }
  .mode-switch button[aria-pressed="true"] { border-color: var(--blood); background: rgba(193,18,31,.12); color: var(--text); }
  .trainer-stats { display: flex; flex-wrap: wrap; gap: 8px 18px; color: var(--muted); font-size: .72rem; text-transform: uppercase; }
  .trainer-stats b { margin-right: 4px; color: var(--amber); font-size: .9rem; }
  .training-grid { display: grid; grid-template-columns: minmax(220px, .72fr) minmax(0, 1.28fr); gap: clamp(18px, 4vw, 50px); align-items: center; padding: clamp(18px, 4vw, 40px); }
  .training-prompt { min-width: 0; }
  .training-callout { min-height: 2.4em; margin: 18px 0 10px; color: var(--amber); font-size: clamp(1.3rem, 3vw, 2.15rem); font-weight: 700; overflow-wrap: anywhere; }
  .training-help { min-height: 4.5em; margin: 0; color: var(--muted); font-size: .85rem; }
  .answer-options { display: grid; gap: 8px; margin-top: 18px; }
  .answer-option { min-height: 44px; border: 1px solid var(--line); border-radius: var(--r); background: var(--panel); padding: 8px 12px; color: var(--text); text-align: left; cursor: pointer; transition: border-color 180ms ease, background 180ms ease; }
  .answer-option:hover:not(:disabled) { border-color: var(--blood-2); background: rgba(193,18,31,.15); }
  .answer-option:disabled { opacity: .6; cursor: default; }
  .training-actions { margin-top: 18px; }
  #next-round:disabled { opacity: .45; cursor: not-allowed; transform: none; }
  .feedback { min-height: 1.6em; margin: 14px 0 0; color: var(--muted); font-size: .84rem; }
  .feedback.is-correct { color: var(--ok); animation: feedback-in 240ms ease-out both; }
  .feedback.is-wrong { color: var(--blood-2); animation: feedback-in 240ms ease-out both; }
  .storage-note { margin: 6px 0 0; color: var(--muted); font-size: .72rem; }
  .training-clock { width: min(100%, 520px); justify-self: center; }

  .message-list { max-width: 860px; margin-inline: auto; }
  .message-row { display: grid; grid-template-columns: 1fr minmax(0, 590px); gap: 14px; align-items: start; margin: 18px 0; }
  .message-row-right { grid-template-columns: minmax(0, 590px) 1fr; }
  .message-row-right .message-meta { grid-column: 2; grid-row: 1; text-align: right; }
  .message-row-right .message-bubble { grid-column: 1; grid-row: 1; }
  .message-meta { padding-top: 6px; }
  .message-bubble { border: 1px solid var(--line); border-left: 2px solid var(--blood); background: var(--panel); padding: 16px 18px; }
  .message-english { margin: 0; color: var(--text); font-weight: 600; }
  .message-spanish { margin: 12px 0 0; color: var(--muted); }
  .message-english span,.message-spanish span { display: block; margin-top: 4px; color: var(--muted); font-family: "JetBrains Mono Variable", monospace; font-size: .62rem; letter-spacing: .08em; text-transform: uppercase; }

  .layer-list { border-top: 1px solid var(--line); }
  .layer-row { display: grid; grid-template-columns: 64px minmax(180px, .8fr) minmax(0, 1.2fr); gap: 20px; align-items: center; border-bottom: 1px solid var(--line); padding: 20px 4px; }
  .layer-number { color: var(--blood-2); font-size: .85rem; }
  .layer-name h3 { margin: 0; font-size: clamp(1.6rem, 3vw, 2.2rem); }
  .layer-name p { margin: 5px 0 0; color: var(--muted); font-size: .83rem; }
  .layer-example { margin: 0; color: var(--amber); font-size: clamp(.85rem, 2vw, 1.12rem); overflow-wrap: anywhere; }

  .layout-source { display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(0, .95fr); gap: clamp(24px, 5vw, 72px); border-top: 1px solid var(--line); padding-top: 24px; }
  .layout-source > div > p { max-width: 660px; margin: 0; color: var(--muted); }
  .source-buttons { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 24px; }
  .source-buttons .btn { gap: 10px; }
  .sources h3 { margin: 0 0 12px; }
  .sources ul { list-style: none; margin: 0; padding: 0; }
  .sources li { border-top: 1px solid var(--line); }
  .sources a { display: flex; justify-content: space-between; gap: 12px; padding: 11px 0; color: var(--muted); font-size: .82rem; }
  .sources a:hover { color: var(--text); }
