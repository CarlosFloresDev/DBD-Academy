---
import '@fontsource/barlow-condensed/600.css';
import '@fontsource/barlow-condensed/700.css';
import '@fontsource/barlow-condensed/800.css';
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  active: 'killers' | 'mapas' | 'survivors' | 'builds' | 'reloj' | 'competitivo' | 'inicio';
}

const { title, description, active } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#06080b" />
    <meta name="description" content={description} />
    <title>{title} | DBD Academy</title>
    <meta property="og:type" content="website" />
    <meta property="og:title" content={`${title} | DBD Academy`} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/og.svg" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} | DBD Academy`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="/og.svg" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <div class="low-fog" aria-hidden="true"></div>
    <div class="global-flicker" aria-hidden="true"></div>
    <div class="page-cut" aria-hidden="true"></div>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <Nav active={active} />
    <main id="contenido"><slot /></main>
    <Footer />
    <script>
      import '../scripts/motion.js';
    </script>
  </body>
</html>

<style is:global>
  .low-fog { position:fixed; z-index:1; right:-8vw; bottom:-8vh; left:-8vw; height:30vh; pointer-events:none; opacity:.11; background:radial-gradient(ellipse at 30% 100%,#88919a 0,rgba(136,145,154,.25) 20%,transparent 68%); filter:blur(20px); animation:fog-drift 24s ease-in-out infinite alternate; }
  .global-flicker { position:fixed; z-index:1; inset:0; pointer-events:none; opacity:0; background:radial-gradient(ellipse at 80% 8%,rgba(193,18,31,.18),transparent 36%); }
  body.motion-ready .global-flicker { animation:red-flicker 16s 1.8s infinite; }
  .page-cut { display:none; position:fixed; z-index:10001; inset:0; pointer-events:none; background:linear-gradient(112deg,transparent 0 42%,var(--blood) 43% 53%,transparent 54%); transform:translateX(-110%); }
  .page-cut.is-running { display:block; animation:page-cut-sweep 400ms cubic-bezier(.76,0,.24,1) forwards; }
  @keyframes fog-drift { from { transform:translate3d(-2%,0,0); opacity:.07; } to { transform:translate3d(2%,-8px,0); opacity:.14; } }
  @keyframes red-flicker { 0%,23%,24.2%,60%,61.3%,86%,87.2%,100% { opacity:0; } 23.15%,60.15%,86.15% { opacity:.55; } }
  @keyframes page-cut-sweep { 0% { transform:translateX(-110%); } 55% { transform:translateX(0); } 100% { transform:translateX(110%); } }
  @media (prefers-reduced-motion:reduce) { .low-fog,.global-flicker,.page-cut { display:none !important; animation:none !important; } }
</style>
