---
interface Props { label:string; value:number; max:number; suffix?:string }
const { label,value,max,suffix='' } = Astro.props;
const pct = Math.min(100,Math.max(0,(value/max)*100));
---
<div class="stat-bar">
  <div class="stat-bar-head"><span>{label}</span><strong class="mono">{value}{suffix}</strong></div>
  <div class="stat-bar-track"><span class="stat-bar-fill" data-width={`${pct}%`} style={`--bar-width:${pct / 100}`}></span></div>
</div>
<style>
 .stat-bar { display:grid; gap:6px; }
 .stat-bar-head { display:flex; justify-content:space-between; color:var(--muted); font-size:.78rem; }
 .stat-bar-head strong { color:var(--amber); }
 .stat-bar-track { height:6px; overflow:hidden; background:var(--line); }
 .stat-bar-fill { position:relative; display:block; width:100%; height:100%; transform:scaleX(var(--bar-width)); transform-origin:left center; background:linear-gradient(90deg,var(--gore),var(--blood),var(--blood-2)); }
 .stat-bar-fill::after { content:""; position:absolute; top:0; right:0; width:14px; height:100%; background:rgba(255,255,255,.62); filter:blur(2px); animation:meniscus 2.8s ease-in-out infinite alternate; }
 @keyframes meniscus { from { opacity:.25; transform:translateX(-4px); } to { opacity:.8; transform:translateX(0); } }
 @media (prefers-reduced-motion:reduce) { .stat-bar-fill::after { animation:none; opacity:.35; } }
</style>
