---
interface Props { label:string; value:number; max:number; suffix?:string }
const { label,value,max,suffix='' } = Astro.props;
const pct = Math.min(100,Math.max(0,(value/max)*100));
---
<div class="stat-bar">
  <div class="stat-bar-head"><span>{label}</span><strong class="mono">{value}{suffix}</strong></div>
  <div class="stat-bar-track"><span class="stat-bar-fill" data-width={`${pct}%`}></span></div>
</div>
<style>
 .stat-bar { display:grid; gap:6px; }
 .stat-bar-head { display:flex; justify-content:space-between; color:var(--muted); font-size:.78rem; }
 .stat-bar-head strong { color:var(--amber); }
 .stat-bar-track { height:5px; overflow:hidden; background:var(--line); }
 .stat-bar-fill { display:block; width:0; height:100%; background:var(--blood); }
</style>
