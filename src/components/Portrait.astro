---
interface Props { src: string; alt: string; size?: 'sm'|'md'|'lg' }
const { src, alt, size='md' } = Astro.props;
---
<div class:list={['portrait',size]}>
  <img src={src} alt={alt} width="480" height="560" loading="lazy" onerror="this.style.display='none';this.nextElementSibling.style.display='grid'" />
  <svg class="portrait-fallback" viewBox="0 0 480 560" role="img" aria-label={alt}>
    <rect width="480" height="560" fill="#10161c"/>
    <path d="M240 58c70 0 112 46 112 105 0 72-38 112-112 112s-112-40-112-112c0-59 42-105 112-105z" fill="#1f2a33"/>
    <path d="M68 560c10-142 73-220 172-220s162 78 172 220z" fill="#1f2a33"/>
    <path d="M240 58v217M128 163h224" stroke="#06080b" stroke-width="5" opacity=".5"/>
  </svg>
</div>
<style>
 .portrait { position:relative; overflow:hidden; aspect-ratio:480/560; border:1px solid var(--line); border-radius:0; clip-path:polygon(0 0,calc(100% - 10px) 0,100% 10px,100% 100%,10px 100%,0 calc(100% - 10px)); background:linear-gradient(145deg,rgba(122,10,18,.12),transparent 42%),var(--panel); }
 .portrait::after { content:""; position:absolute; inset:auto 0 0; height:24%; pointer-events:none; background:linear-gradient(0deg,rgba(6,8,11,.5),transparent); }
 .portrait.sm { width:120px; } .portrait.md { width:100%; } .portrait.lg { width:min(100%,360px); }
 .portrait img { width:100%; height:100%; object-fit:cover; object-position:center top; }
 .portrait-fallback { display:none; width:100%; height:100%; }
</style>
