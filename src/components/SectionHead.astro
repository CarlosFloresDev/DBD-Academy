---
interface Props { eyebrow:string; title:string; description?:string }
const { eyebrow,title,description } = Astro.props;
---
<header class="section-head" data-reveal>
  <p class="eyebrow">{eyebrow}</p>
  <h2 class="display">{title}</h2>
  {description && <p>{description}</p>}
</header>
<style>
 .section-head { max-width:760px; margin-bottom:32px; }
 .section-head h2 { margin-top:8px; font-size:clamp(2.6rem,7vw,5.4rem); }
 .section-head > p:last-child { max-width:620px; margin:16px 0 0; color:var(--muted); }
</style>
