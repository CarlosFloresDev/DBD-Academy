---
interface Props { seed?: number | string; size?: number; tone?: 'blood' | 'gore' | 'rust' }
const { seed = 1, size = 180, tone = 'blood' } = Astro.props;
let state = String(seed).split('').reduce((value, char) => (value * 31 + char.charCodeAt(0)) >>> 0, 7) || 7;
const rand = () => { state = (state * 1664525 + 1013904223) >>> 0; return state / 4294967296; };
const drops = Array.from({ length: 11 }, () => ({
  x: Math.round(12 + rand() * 76),
  y: Math.round(12 + rand() * 76),
  r: Math.round(1 + rand() * 4),
}));
---
<svg class:list={['splatter', `tone-${tone}`]} width={size} height={size} viewBox="0 0 100 100" aria-hidden="true">
  <path class="main-splash" d="M49 10 56 24 68 19 66 31 84 32 73 42 88 50 69 55 74 68 60 65 54 86 44 69 32 81 31 64 13 67 24 53 8 45 26 39 20 27 35 31z"/>
  {drops.map((drop) => <ellipse cx={drop.x} cy={drop.y} rx={drop.r} ry={Math.max(1, Math.round(drop.r * 1.5))} transform={`rotate(${Math.round(rand() * 110 - 55)} ${drop.x} ${drop.y})`} />)}
</svg>
<style>
  .splatter { position:absolute; z-index:0; overflow:visible; pointer-events:none; opacity:.34; }
  .splatter path,.splatter ellipse { fill:var(--splatter-color,var(--blood)); }
  .splatter .main-splash { stroke:var(--blood-2); stroke-width:.7; }
  .tone-gore { --splatter-color:var(--gore); opacity:.38; }
  .tone-rust { --splatter-color:var(--rust); opacity:.27; }
</style>
