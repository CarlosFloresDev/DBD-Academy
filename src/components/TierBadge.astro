---
interface Props { tier?: 'S'|'A'|'B'|'C'|'D'|null }
const { tier=null } = Astro.props;
---
{tier ? (
  <span class:list={['tier-badge','tier-'+tier.toLowerCase()]} aria-label={`Tier ${tier}`}>Tier {tier}</span>
) : (
  <span class="tier-badge tier-null">Sin tier</span>
)}
<style>
 .tier-badge { display:inline-flex; align-items:center; justify-content:center; min-width:58px; height:30px; border:1px solid var(--line); border-radius:999px; font-family:"JetBrains Mono Variable",monospace; font-size:.72rem; font-weight:800; }
 .tier-s { position:relative; border-color:var(--blood-2); background:rgba(193,18,31,.22); color:var(--blood-2); box-shadow:0 0 12px rgba(193,18,31,.18); }
 .tier-s::after { content:""; width:4px; height:4px; margin-left:5px; border-radius:50%; background:var(--blood-2); box-shadow:0 0 7px var(--blood-2); }
 .tier-a { border-color:var(--ember); color:var(--ember); }
 .tier-b { border-color:var(--amber); color:var(--amber); }
 .tier-c { border-color:var(--ice); color:var(--ice); }
 .tier-d { color:var(--muted); }
 .tier-null { color:var(--muted); }
</style>
