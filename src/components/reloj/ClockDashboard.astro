---
import clock from '../../data/clock.json';
import killers from '../../data/killers.json';
import SectionHead from '../SectionHead.astro';

const genTable = clock.generador.porNumeroDeSobrevivientes;
const defaultCrew = genTable.find((row) => row.n === 4)!;
const formatClock = (seconds: number, decimals = 2) => {
  const minutes = Math.floor(seconds / 60);
  const remainder = seconds - minutes * 60;
  return `${String(minutes).padStart(2, '0')}:${remainder.toFixed(decimals).padStart(decimals === 2 ? 5 : 2, '0')}`;
};
const genRingCircumference = 2 * Math.PI * 112;
const defaultKiller = killers.find((killer) => killer.slug === 'nurse')!;
const initialPursuitDistance = 20;
const defaultPursuitCanCatch = defaultKiller.speed > clock.movimiento.sobrevivienteMs;
const defaultPursuitSeconds = defaultPursuitCanCatch
  ? initialPursuitDistance / (defaultKiller.speed - clock.movimiento.sobrevivienteMs)
  : null;
const selfUnhookChance = (1 - Math.pow(1 - clock.gancho.autodescolgarseProbabilidadPct / 100, clock.gancho.autodescolgarseIntentosMax)) * 100;
const hookTotalSeconds = clock.gancho.etapa1Segundos + clock.gancho.etapa2Segundos;
const pursuitKillers = killers.map(({ slug, name, speed, altSpeeds }) => ({ slug, name, speed, altSpeeds }));
const allConstantGroups = [
  { title: 'Generador', rows: [
    ['Cargas totales', clock.generador.cargasTotales, 'cargas'],
    ['Generadores necesarios', clock.generador.necesarios, ''],
    ['Tiempo de patada', clock.generador.patadaSegundos, 's'],
    ['Penalización por patada', clock.generador.patadaPenalizacionPct, '%'],
    ['Penalización por fallo', clock.generador.skillCheckFalloPenalizacionPct, '%'],
    ['Bonus skill check excelente', clock.generador.skillCheckGreatBonusPct, '%'],
    ['Regresion completa', clock.generador.regresionCompletaSegundos, 's'],
  ]},
  { title: 'Gancho', rows: [
    ['Etapa 1', clock.gancho.etapa1Segundos, 's'],
    ['Etapa 2', clock.gancho.etapa2Segundos, 's'],
    ['Tiempo de colgado', clock.gancho.colgarSegundos, 's'],
    ['Probabilidad por intento de autodescolgado', clock.gancho.autodescolgarseProbabilidadPct, '%'],
    ['Penalización por intento fallido', clock.gancho.autodescolgarseFalloPenalizacionSegundos, 's'],
    ['Intentos maximos', clock.gancho.autodescolgarseIntentosMax, ''],
    ['Gancho roto tras sacrificio', clock.gancho.ganchoRotoTrasSacrificioSegundos, 's'],
    ['Forcejeo para soltarse', clock.gancho.forcejeoParaSoltarseSegundos, 's'],
  ]},
  { title: 'Salida', rows: [
    ['Abrir puerta', clock.salida.abrirPuertaSegundos, 's'],
    ['Killer abre puerta', clock.salida.killerAbrePuertaSegundos, 's'],
    ['Escotilla', clock.salida.escotillaSegundos, 's'],
  ]},
  { title: 'Movimiento', rows: [
    ['Velocidad survivor', clock.movimiento.sobrevivienteMs, 'm/s'],
    ['Velocidad killer base', clock.movimiento.killerBaseMs, 'm/s'],
    ['Killer base', clock.movimiento.killerBasePct, '%'],
    ['Killer lento', clock.movimiento.killerLentoMs, 'm/s'],
    ['Killer lento', clock.movimiento.killerLentoPct, '%'],
    ['Radio de terror estándar', clock.movimiento.radioTerrorEstandarM, 'm'],
  ]},
  { title: 'Objetos', rows: [
    ['Romper pallet', clock.objetos.romperPalletSegundos, 's'],
    ['Entrar o salir de locker', clock.objetos.lockerSegundos, 's'],
  ]},
];
---

<div class="clock-page" data-clock-config={JSON.stringify(clock)} data-killers={JSON.stringify(pursuitKillers)}>
  <header class="clock-hero container">
    <div>
      <p class="eyebrow">Instrumentos de partida · Datos verificables</p>
      <h1 class="display">El reloj<br /><span>del trial</span></h1>
      <p class="hero-copy">Los segundos cambian decisiones. Calcula el progreso de un generador, el ritmo del equipo y el tiempo que una persecución compra.</p>
    </div>
    <div class="hero-readout" aria-label={`Referencia: ${clock.generador.necesarios} generadores, ${clock.generador.cargasTotales} cargas cada uno`}>
      <span class="mono">{clock.generador.necesarios} GEN / {clock.generador.cargasTotales} CARGAS</span>
      <strong class="mono">{defaultCrew.segundos.toFixed(2)}<small> s</small></strong>
      <span>{defaultCrew.n} survivors · reparación perfecta</span>
    </div>
  </header>

  <section class="container section-block" aria-label="Cronometro de generador">
    <SectionHead eyebrow="01 / Generadores" title="Cronómetro de gen" description="Ajusta supervivientes, patadas y skill checks para ver cuánto tarda en completarse la carga restante." />
    <div class="generator-layout">
      <div class="generator-console card">
        <div class="ring-wrap">
          <svg class="generator-ring" viewBox="0 0 260 260" role="img" aria-labelledby="gen-ring-title gen-ring-desc">
            <title id="gen-ring-title">Progreso del generador</title>
            <desc id="gen-ring-desc">El aro muestra la fracción de la reparación que sigue pendiente.</desc>
            <circle class="ring-track" cx="130" cy="130" r="112" />
            <circle class="ring-progress" data-gen-ring cx="130" cy="130" r="112" stroke-dasharray={genRingCircumference} stroke-dashoffset="0" />
          </svg>
          <div class="ring-copy">
            <span class="eyebrow" data-gen-state aria-live="polite">LISTO</span>
            <strong class="mono" data-gen-clock aria-live="off">{formatClock(defaultCrew.segundos)}</strong>
            <span>restante</span>
          </div>
        </div>
        <div class="generator-controls">
          <fieldset>
            <legend>Survivors reparando</legend>
            <div class="segments" role="radiogroup" aria-label="Número de survivors reparando">
              {genTable.map((row) => <button type="button" class="segment" data-survivors={row.n} aria-pressed={row.n === 4 ? 'true' : 'false'}>{row.n}</button>)}
            </div>
          </fieldset>
          <fieldset>
            <legend>Patadas del killer</legend>
            <div class="segments kick-segments" role="radiogroup" aria-label="Número de patadas al generador">
              {Array.from({ length: 7 }, (_, index) => <button type="button" class="segment" data-kicks={index} aria-pressed={index === 0 ? 'true' : 'false'}>{index}</button>)}
            </div>
          </fieldset>
          <label class="fail-toggle">
            <input type="checkbox" data-failed-check />
            <span><strong>Un fallo</strong><small>Skill checks normales · sin bonus excelente</small></span>
          </label>
          <div class="speed-controls" role="group" aria-label="Velocidad del cronometro">
            <span>Velocidad</span>
            {[1, 4, 10].map((speed) => <button type="button" data-clock-speed={speed} aria-pressed={speed === 1 ? 'true' : 'false'}>x{speed}</button>)}
          </div>
          <button type="button" class="btn btn-primary start-clock" data-gen-start>Iniciar</button>
        </div>
      </div>
      <aside class="generator-data">
        <div class="result-line">
          <span>Tiempo calculado</span>
          <strong class="mono" data-gen-result aria-live="polite">{defaultCrew.segundos.toFixed(2).replace('.', ',')} s</strong>
        </div>
        <div class="formula card">
          <p class="eyebrow">Fórmula</p>
          <p>Cargas pendientes = {clock.generador.cargasTotales} − (patadas × {clock.generador.patadaPenalizacionPct}% × {clock.generador.cargasTotales}) − (fallo × {clock.generador.skillCheckFalloPenalizacionPct}% × {clock.generador.cargasTotales}).</p>
          <p>Tiempo = cargas pendientes ÷ (survivors × eficiencia individual).</p>
        </div>
        <div class="comparison card">
          <h3 class="display">Referencia limpia</h3>
          <table>
            <thead><tr><th>Survivors</th><th>Cargas/s</th><th>Segundos</th></tr></thead>
            <tbody>{genTable.map((row) => <tr data-ref-n={row.n}><td>{row.n}</td><td class="mono">{row.cargasPorSegundo.toFixed(2).replace('.', ',')}</td><td class="mono">{row.segundos.toFixed(2).replace('.', ',')} s</td></tr>)}</tbody>
          </table>
          <p class="fine-print">La comparación usa reparación sin patadas ni fallos.</p>
        </div>
      </aside>
    </div>
  </section>

  <section class="container section-block" aria-label="Linea del trial">
    <SectionHead eyebrow="02 / Ritmo de equipo" title="Línea del trial" description={`Tres repartos posibles para completar los ${clock.generador.necesarios} generadores, antes de sumar el tiempo de persecuciones.`} />
    <div class="chase-slider card">
      <label for="chase-seconds">Tiempo total del killer en persecuciones</label>
      <output class="mono" data-chase-output for="chase-seconds">00:00</output>
      <input id="chase-seconds" type="range" min="0" max="300" step="1" value="0" />
      <div class="range-scale mono"><span>00:00</span><span>05:00</span></div>
    </div>
    <div class="scenario-list">
      {clock.escenarios.map((scenario) => (
        <article class="scenario card" data-scenario data-seconds={scenario.segundos}>
          <div class="scenario-head">
            <div><p class="eyebrow">{scenario.calculo}</p><h3 class="display">{scenario.titulo}</h3><p>{scenario.descripcion}</p></div>
            <div class="scenario-time"><strong class="mono">{scenario.segundos.toFixed(2).replace('.', ',')} s</strong><span>reparación pura</span></div>
          </div>
          <div class="timeline-track" role="img" aria-label={`Línea de tiempo para ${scenario.titulo}`}>
            <span class="timeline-fill" data-scenario-fill></span>
            <span class="timeline-marker" data-scenario-marker></span>
            <span class="timeline-door" data-scenario-door></span>
          </div>
          <div class="timeline-legend"><span>{clock.generador.necesarios} gens listos <b class="mono" data-repair-time>{formatClock(scenario.segundos)}</b></span><span>Puertas abiertas <b class="mono" data-door-time>{formatClock(scenario.segundos + clock.salida.abrirPuertaSegundos)}</b></span></div>
        </article>
      ))}
    </div>
    <p class="notice">{clock.avisoEscenarios}</p>
  </section>

  <section class="container section-block" aria-label="Reloj del gancho">
    <SectionHead eyebrow="03 / Gancho" title="Tiempo en gancho" description={`Dos etapas de ${clock.gancho.etapa1Segundos} segundos. El reloj corre aunque cambie la tensión de la partida.`} />
    <div class="hook-layout card">
      <div class="hook-visual">
        <svg viewBox="0 0 260 260" role="img" aria-label="Dos anillos de progreso que representan las etapas del gancho">
          <circle class="ring-track" cx="130" cy="130" r="108" />
          <circle class="hook-ring stage-one" data-hook-one cx="130" cy="130" r="108" />
          <circle class="ring-track inner-track" cx="130" cy="130" r="82" />
          <circle class="hook-ring stage-two" data-hook-two cx="130" cy="130" r="82" />
        </svg>
        <div class="hook-center"><strong class="mono" data-hook-clock aria-live="off">{`${String(Math.floor(hookTotalSeconds / 60)).padStart(2, '0')}:${String(hookTotalSeconds % 60).padStart(2, '0')}`}</strong><span data-hook-state aria-live="polite">ETAPA 1 + 2</span></div>
      </div>
      <div class="hook-info">
        <div class="stage-pair">
          <div><span>Etapa 1</span><strong class="mono">{clock.gancho.etapa1Segundos} s</strong></div>
          <div><span>Etapa 2</span><strong class="mono">{clock.gancho.etapa2Segundos} s</strong></div>
        </div>
        <button type="button" class="btn btn-secondary" data-hook-start>Reproducir reloj</button>
        <div class="hook-facts">
          <div><span>Autodescolgado</span><strong class="mono">{clock.gancho.autodescolgarseProbabilidadPct}% <small>por intento</small></strong><p>{clock.gancho.autodescolgarseFalloPenalizacionSegundos} s de penalización si falla · hasta {clock.gancho.autodescolgarseIntentosMax} intentos.</p></div>
          <div><span>Éxito acumulado en {clock.gancho.autodescolgarseIntentosMax} intentos</span><strong class="mono">{selfUnhookChance.toFixed(2).replace('.', ',')}%</strong><p>Probabilidad acumulada, no garantía.</p></div>
          <div><span>Forcejeo para soltarse</span><strong class="mono">{clock.gancho.forcejeoParaSoltarseSegundos} s</strong></div>
          <div><span>Gancho roto tras sacrificio</span><strong class="mono">{clock.gancho.ganchoRotoTrasSacrificioSegundos} s</strong></div>
        </div>
      </div>
    </div>
  </section>

  <section class="container section-block" aria-label="Calculadora de persecucion">
    <SectionHead eyebrow="04 / Persecución" title="Velocidad de alcance" description="Compara la velocidad del killer seleccionado con la velocidad base de carrera del survivor." />
    <div class="pursuit-layout card">
      <div class="pursuit-controls">
        <label for="killer-select">Killer<select id="killer-select" data-killer-select>{killers.map((killer) => <option value={killer.slug} selected={killer.slug === 'nurse'}>{killer.name}</option>)}</select></label>
        <label for="movement-mode">Modo de movimiento<select id="movement-mode" data-mode-select><option value="base">Velocidad base</option></select></label>
        <label for="distance-range">Distancia inicial <output class="mono" data-distance-output>{initialPursuitDistance} m</output><input id="distance-range" type="range" min="0" max="40" step="1" value={initialPursuitDistance} /></label>
        <p class="fine-print">Cálculo teórico en línea recta, sin obstáculos.</p>
      </div>
      <div class="pursuit-result">
        <svg class="runner-track" viewBox="0 0 320 88" role="img" aria-label="Animacion de la distancia entre survivor y killer">
          <path d="M22 44H298" stroke="#1f2a33" stroke-width="2" stroke-dasharray="5 7" />
          <circle data-runner="survivor" cx="40" cy="30" r="8" fill="#7dd3fc" />
          <circle data-runner="killer" cx="40" cy="58" r="8" fill="#c1121f" />
          <text x="20" y="15" fill="#8b97a1" font-size="9">SURVIVOR</text>
          <text x="20" y="82" fill="#8b97a1" font-size="9">KILLER</text>
        </svg>
        <p class="eyebrow" data-pursuit-status>{defaultPursuitCanCatch ? 'VENTAJA DEL KILLER' : 'SIN VENTAJA DE VELOCIDAD'}</p>
        <strong class="mono pursuit-time" data-pursuit-time aria-live="polite">{defaultPursuitCanCatch && defaultPursuitSeconds !== null ? `${defaultPursuitSeconds.toFixed(2).replace('.', ',')} s` : 'No alcanza'}</strong>
        <p class="fine-print" data-pursuit-detail>{defaultKiller.name}: {defaultKiller.speed} m/s · Survivor: {clock.movimiento.sobrevivienteMs} m/s.</p>
      </div>
    </div>
  </section>

  <section class="container section-block" aria-label="Objetivos de ritmo">
    <SectionHead eyebrow="05 / Entrenamiento" title="Objetivos de ritmo" description="Hitos medibles para entrenar sin convertir estimaciones en reglas de partida." />
    <div class="objectives">
      {[
        { title: 'Termina un gen en solitario', value: genTable.find((row) => row.n === 1)?.segundos, basis: `${genTable.find((row) => row.n === 1)?.n} persona aporta ${genTable.find((row) => row.n === 1)?.cargasPorSegundo} carga/s.` },
        { title: 'Termina un gen en pareja', value: genTable.find((row) => row.n === 2)?.segundos, basis: `${genTable.find((row) => row.n === 2)?.n} personas aportan ${genTable.find((row) => row.n === 2)?.cargasPorSegundo} cargas/s.` },
        { title: 'Termina un gen entre cuatro', value: genTable.find((row) => row.n === 4)?.segundos, basis: `${genTable.find((row) => row.n === 4)?.n} personas aportan ${genTable.find((row) => row.n === 4)?.cargasPorSegundo} cargas/s.` },
        { title: 'Mide una etapa completa de gancho', value: clock.gancho.etapa1Segundos, basis: 'Cada etapa dura lo mismo.' },
        { title: 'Practica una apertura de puerta', value: clock.salida.abrirPuertaSegundos, basis: 'Tiempo de apertura sin interrupciones.' },
        { title: 'Rompe un pallet sin perder tiempo extra', value: clock.objetos.romperPalletSegundos, basis: 'Duracion de la accion de romper.' },
      ].map((item, index) => (
        <article class="objective">
          <span class="mono objective-index">0{index + 1}</span>
          <div><h3>{item.title}</h3><p>{item.basis}</p></div>
          <strong class="mono">{item.value?.toFixed(2).replace('.', ',')} s</strong>
          <span class="objective-notice">{clock.avisoObjetivos}</span>
        </article>
      ))}
    </div>
  </section>

  <section class="container section-block print-section" aria-label="Hoja de numeros">
    <SectionHead eyebrow="06 / Referencia" title="Hoja de números" description="Constantes del juego y referencia de origen. Imprime esta sección para tenerla a mano." />
    <div class="print-sheet">
      <div class="sheet-heading"><div><p class="eyebrow">DBD Academy / Referencia</p><h3 class="display">Constantes del juego</h3></div><span class="mono">FUENTE / WIKI OFICIAL</span></div>
      <div class="constant-groups">
        {allConstantGroups.map((group) => (
          <div class="constant-group"><h4>{group.title}</h4><dl>{group.rows.map(([label, value, unit]) => <div><dt>{label}</dt><dd class="mono">{value} {unit}</dd></div>)}</dl></div>
        ))}
        <div class="constant-group"><h4>Generadores por survivors</h4><dl>{genTable.map((row) => <div><dt>{row.n} survivor{row.n === 1 ? '' : 's'} · {row.eficienciaIndividual} carga/s por persona</dt><dd class="mono">{row.cargasPorSegundo} cargas/s · {row.segundos.toFixed(2)} s</dd></div>)}</dl></div>
        <div class="constant-group"><h4>Escenarios de reparación</h4><dl>{clock.escenarios.map((scenario) => <div><dt>{scenario.titulo}</dt><dd class="mono">{scenario.calculo} = {scenario.segundos.toFixed(2)} s</dd></div>)}</dl></div>
      </div>
      <p class="sheet-source">Fuente: {clock.fuente}. Valores de juego; los tiempos de escenarios son cálculos teóricos.</p>
    </div>
    <button type="button" class="btn btn-secondary print-button" data-print>Imprimir hoja de números</button>
  </section>
</div>

<script>
  import { gsap } from 'gsap';

  const root = document.querySelector<HTMLElement>('.clock-page');
  if (root) {
    const config = JSON.parse(root.getAttribute('data-clock-config') || '{}');
    const killersData = JSON.parse(root.getAttribute('data-killers') || '[]');
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const formatSeconds = (value: number, decimals = 2) => {
      const safe = Math.max(0, value);
      const minutes = Math.floor(safe / 60);
      const seconds = safe - minutes * 60;
      return `${String(minutes).padStart(2, '0')}:${seconds.toFixed(decimals).padStart(decimals === 2 ? 5 : 2, '0')}`;
    };

    const survivorButtons = [...root.querySelectorAll<HTMLButtonElement>('[data-survivors]')];
    const kickButtons = [...root.querySelectorAll<HTMLButtonElement>('[data-kicks]')];
    const speedButtons = [...root.querySelectorAll<HTMLButtonElement>('[data-clock-speed]')];
    const failedCheck = root.querySelector<HTMLInputElement>('[data-failed-check]')!;
    const genRing = root.querySelector<SVGCircleElement>('[data-gen-ring]');
    const genClock = root.querySelector<HTMLElement>('[data-gen-clock]')!;
    const genResult = root.querySelector<HTMLElement>('[data-gen-result]')!;
    const genState = root.querySelector<HTMLElement>('[data-gen-state]')!;
    const genStart = root.querySelector<HTMLButtonElement>('[data-gen-start]')!;
    const circumference = 2 * Math.PI * 112;
    let survivorCount = Number(root.querySelector<HTMLButtonElement>('[data-survivors][aria-pressed="true"]')?.getAttribute('data-survivors'));
    let kickCount = 0;
    let speed = 1;
    let elapsed = 0;
    let previousFrame = 0;
    let timerFrame = 0;
    let running = false;
    let totalGenSeconds = 0;
    genRing?.setAttribute('stroke-dasharray', `${circumference}`);
    genRing?.setAttribute('stroke-dashoffset', '0');

    const estimateGenerator = () => {
      const row = config.generador.porNumeroDeSobrevivientes.find((entry) => entry.n === survivorCount);
      const lost = kickCount * config.generador.cargasTotales * config.generador.patadaPenalizacionPct / 100
        + (failedCheck.checked ? config.generador.cargasTotales * config.generador.skillCheckFalloPenalizacionPct / 100 : 0);
      const remaining = Math.max(0, config.generador.cargasTotales - lost);
      totalGenSeconds = remaining / (row.eficienciaIndividual * survivorCount);
      genResult.textContent = `${totalGenSeconds.toFixed(2).replace('.', ',')} s`;
      genClock.textContent = formatSeconds(totalGenSeconds);
      genRing?.setAttribute('stroke-dashoffset', String(circumference * (1 - remaining / config.generador.cargasTotales)));
      root.querySelectorAll('[data-ref-n]').forEach((line) => line.classList.toggle('selected', Number(line.getAttribute('data-ref-n')) === survivorCount));
      elapsed = 0;
      running = false;
      cancelAnimationFrame(timerFrame);
      genStart.textContent = 'Iniciar';
      genState.textContent = remaining === 0 ? 'COMPLETADO' : 'LISTO';
    };

    const tick = (timestamp: number) => {
      if (!running) return;
      if (previousFrame) elapsed += (timestamp - previousFrame) / 1000 * speed;
      previousFrame = timestamp;
      const remaining = Math.max(0, totalGenSeconds - elapsed);
      genClock.textContent = formatSeconds(remaining);
      genRing?.setAttribute('stroke-dashoffset', String(circumference * (1 - remaining / totalGenSeconds)));
      if (remaining <= 0) {
        running = false;
        genState.textContent = 'COMPLETADO';
        genStart.textContent = 'Reiniciar';
        return;
      }
      timerFrame = requestAnimationFrame(tick);
    };

    const setPressed = (buttons: HTMLButtonElement[], active: HTMLButtonElement) => buttons.forEach((button) => button.setAttribute('aria-pressed', String(button === active)));
    survivorButtons.forEach((button) => button.addEventListener('click', () => {
      survivorCount = Number(button.getAttribute('data-survivors'));
      setPressed(survivorButtons, button);
      estimateGenerator();
    }));
    kickButtons.forEach((button) => button.addEventListener('click', () => {
      kickCount = Number(button.getAttribute('data-kicks'));
      setPressed(kickButtons, button);
      estimateGenerator();
    }));
    failedCheck.addEventListener('change', estimateGenerator);
    speedButtons.forEach((button) => button.addEventListener('click', () => {
      speed = Number(button.getAttribute('data-clock-speed'));
      setPressed(speedButtons, button);
    }));
    genStart.addEventListener('click', () => {
      if (running) {
        running = false;
        genStart.textContent = 'Continuar';
        genState.textContent = 'PAUSADO';
        return;
      }
      if (elapsed >= totalGenSeconds) elapsed = 0;
      if (totalGenSeconds <= 0) {
        genState.textContent = 'COMPLETADO';
        return;
      }
      running = true;
      previousFrame = 0;
      genStart.textContent = 'Pausar';
      genState.textContent = 'EN CURSO';
      timerFrame = requestAnimationFrame(tick);
    });
    estimateGenerator();

    const chaseRange = root.querySelector<HTMLInputElement>('#chase-seconds')!;
    const chaseOutput = root.querySelector<HTMLOutputElement>('[data-chase-output]')!;
    const scenarios = [...root.querySelectorAll<HTMLElement>('[data-scenario]')];
    let scenarioTimeline: gsap.core.Timeline | undefined;
    const updateScenarios = () => {
      const chaseSeconds = Number(chaseRange.value);
      chaseOutput.textContent = formatSeconds(chaseSeconds, 0);
      const max = Math.max(...scenarios.map((scenario) => Number(scenario.getAttribute('data-seconds')) + chaseSeconds + config.salida.abrirPuertaSegundos));
      scenarios.forEach((scenario) => {
        const repair = Number(scenario.getAttribute('data-seconds'));
        const doorsPowered = repair + chaseSeconds;
        const doorsOpen = doorsPowered + config.salida.abrirPuertaSegundos;
        const marker = scenario.querySelector<HTMLElement>('[data-scenario-marker]')!;
        const door = scenario.querySelector<HTMLElement>('[data-scenario-door]')!;
        const fill = scenario.querySelector<HTMLElement>('[data-scenario-fill]')!;
        const repairTime = scenario.querySelector<HTMLElement>('[data-repair-time]')!;
        const doorTime = scenario.querySelector<HTMLElement>('[data-door-time]')!;
        marker.style.left = `${doorsPowered / max * 100}%`;
        door.style.left = `${doorsOpen / max * 100}%`;
        repairTime.textContent = formatSeconds(doorsPowered);
        doorTime.textContent = formatSeconds(doorsOpen);
      });
      if (reducedMotion) {
        scenarios.forEach((scenario) => {
          const fill = scenario.querySelector<HTMLElement>('[data-scenario-fill]')!;
          gsap.set(fill, { scaleX: Number(scenario.getAttribute('data-seconds')) / max, transformOrigin: 'left center' });
        });
      } else {
        scenarioTimeline?.kill();
        scenarioTimeline = gsap.timeline();
        scenarios.forEach((scenario) => {
          const fill = scenario.querySelector<HTMLElement>('[data-scenario-fill]')!;
          const repair = Number(scenario.getAttribute('data-seconds'));
          scenarioTimeline!.to(fill, { scaleX: repair / max, duration: 0.45, ease: 'power3.out', transformOrigin: 'left center' }, 0);
        });
      }
    };
    chaseRange.addEventListener('input', updateScenarios);
    updateScenarios();

    const hookOne = root.querySelector<SVGCircleElement>('[data-hook-one]')!;
    const hookTwo = root.querySelector<SVGCircleElement>('[data-hook-two]')!;
    const hookClock = root.querySelector<HTMLElement>('[data-hook-clock]')!;
    const hookState = root.querySelector<HTMLElement>('[data-hook-state]')!;
    const hookStart = root.querySelector<HTMLButtonElement>('[data-hook-start]')!;
    const oneLength = 2 * Math.PI * 108;
    const twoLength = 2 * Math.PI * 82;
    hookOne.setAttribute('stroke-dasharray', String(oneLength));
    hookTwo.setAttribute('stroke-dasharray', String(twoLength));
    let hookElapsed = 0;
    let hookInterval: number | null = null;
    hookStart.addEventListener('click', () => {
      if (hookInterval !== null) {
        if (hookInterval !== null) clearInterval(hookInterval);
        hookInterval = null;
        hookStart.textContent = 'Continuar reloj';
        hookState.textContent = 'PAUSADO';
        return;
      }
      if (hookElapsed >= config.gancho.etapa1Segundos + config.gancho.etapa2Segundos) hookElapsed = 0;
      hookStart.textContent = 'Pausar reloj';
      hookState.textContent = hookElapsed < config.gancho.etapa1Segundos ? 'ETAPA 1' : 'ETAPA 2';
      hookInterval = window.setInterval(() => {
        hookElapsed = Math.min(config.gancho.etapa1Segundos + config.gancho.etapa2Segundos, hookElapsed + 0.1);
        const firstProgress = Math.min(1, hookElapsed / config.gancho.etapa1Segundos);
        const secondProgress = Math.max(0, Math.min(1, (hookElapsed - config.gancho.etapa1Segundos) / config.gancho.etapa2Segundos));
        hookOne.setAttribute('stroke-dashoffset', String(oneLength * firstProgress));
        hookTwo.setAttribute('stroke-dashoffset', String(twoLength * secondProgress));
        hookClock.textContent = formatSeconds(config.gancho.etapa1Segundos + config.gancho.etapa2Segundos - hookElapsed, 0);
        hookState.textContent = hookElapsed < config.gancho.etapa1Segundos ? 'ETAPA 1' : hookElapsed < config.gancho.etapa1Segundos + config.gancho.etapa2Segundos ? 'ETAPA 2' : 'SACRIFICIO';
        if (hookElapsed >= config.gancho.etapa1Segundos + config.gancho.etapa2Segundos) {
          clearInterval(hookInterval);
          hookInterval = null;
          hookStart.textContent = 'Reiniciar reloj';
        }
      }, 100);
    });

    const killerSelect = root.querySelector<HTMLSelectElement>('[data-killer-select]')!;
    const modeSelect = root.querySelector<HTMLSelectElement>('[data-mode-select]')!;
    const distanceRange = root.querySelector<HTMLInputElement>('#distance-range')!;
    const distanceOutput = root.querySelector<HTMLOutputElement>('[data-distance-output]')!;
    const pursuitTime = root.querySelector<HTMLElement>('[data-pursuit-time]')!;
    const pursuitStatus = root.querySelector<HTMLElement>('[data-pursuit-status]')!;
    const pursuitDetail = root.querySelector<HTMLElement>('[data-pursuit-detail]')!;
    const runnerSurvivor = root.querySelector<SVGCircleElement>('[data-runner="survivor"]')!;
    const runnerKiller = root.querySelector<SVGCircleElement>('[data-runner="killer"]')!;
    let runnerTween: gsap.core.Animation | undefined;
    const selectedKiller = () => killersData.find((killer) => killer.slug === killerSelect.value);
    const updateModes = () => {
      const killer = selectedKiller();
      modeSelect.innerHTML = '<option value="base">Velocidad base</option>';
      killer.altSpeeds.forEach((mode, index) => {
        const option = document.createElement('option');
        option.value = String(index);
        option.textContent = `${mode.label} · ${mode.speed} m/s`;
        modeSelect.append(option);
      });
      modeSelect.value = 'base';
      updatePursuit();
    };
    const updatePursuit = () => {
      const killer = selectedKiller();
      const mode = modeSelect.value === 'base' ? null : killer.altSpeeds[Number(modeSelect.value)];
      const killerSpeed = mode ? mode.speed : killer.speed;
      const survivorSpeed = config.movimiento.sobrevivienteMs;
      const distance = Number(distanceRange.value);
      const difference = killerSpeed - survivorSpeed;
      distanceOutput.textContent = `${distance} m`;
      if (difference <= 0) {
        pursuitTime.textContent = 'No alcanza';
        pursuitStatus.textContent = 'SIN VENTAJA DE VELOCIDAD';
        pursuitDetail.textContent = `${killer.name}: ${killerSpeed} m/s · Survivor: ${survivorSpeed} m/s.`;
      } else {
        const seconds = distance / difference;
        pursuitTime.textContent = `${seconds.toFixed(2).replace('.', ',')} s`;
        pursuitStatus.textContent = 'VENTAJA DEL KILLER';
        pursuitDetail.textContent = `${killer.name}: ${killerSpeed} m/s · Survivor: ${survivorSpeed} m/s · diferencia: ${difference.toFixed(2)} m/s.`;
      }
      if (runnerTween) runnerTween.kill();
      gsap.set([runnerSurvivor, runnerKiller], { x: 0 });
      if (distance > 0 && !reducedMotion) {
        runnerTween = gsap.timeline({ repeat: -1, defaults: { ease: 'none' } })
          .to(runnerSurvivor, { x: 230, duration: 2.4 }, 0)
          .to(runnerKiller, { x: 230, duration: Math.max(0.35, 2.4 * survivorSpeed / killerSpeed) }, 0);
      } else if (distance > 0) {
        gsap.set([runnerSurvivor, runnerKiller], { x: 230 });
      }
    };
    killerSelect.addEventListener('change', updateModes);
    modeSelect.addEventListener('change', updatePursuit);
    distanceRange.addEventListener('input', updatePursuit);
    updateModes();
    root.querySelector<HTMLButtonElement>('[data-print]')!.addEventListener('click', () => window.print());
  }
</script>

